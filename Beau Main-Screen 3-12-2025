import pygame

pygame.init()

breedte = 800
hoogte = 600
screen = pygame.display.set_mode((breedte, hoogte))

def mainscreen():
    startbutton = pygame.image.load("startbutton.png")
    startbuttonrect = startbutton.get_rect()
    
    optionsbutton = pygame.image.load("Optionsbutton.png")
    optionsbuttonrect = optionsbutton.get_rect()
    
    exitbutton = pygame.image.load("Exitbutton.png")
    exitbuttonrect = optionsbutton.get_rect()
    
    while True:
        startbuttonrect.center = (400, 100)
        screen.blit(startbutton, startbuttonrect)
        
        optionsbuttonrect.center = (400, 300)
        screen.blit(optionsbutton, optionsbuttonrect)
        
        exitbuttonrect.center = (400, 500)
        screen.blit(exitbutton, exitbuttonrect)
        pygame.display.flip()
    
    
        pygame.event.get()
        locatie_muis = pygame.mouse.get_pos()
        knoppen = pygame.mouse.get_pressed()
    
        if knoppen[0] == 1:
            if startbuttonrect.collidepoint(locatie_muis):
                exit()
            if optionsbuttonrect.collidepoint(locatie_muis):
                exit()
            if exitbuttonrect.collidepoint(locatie_muis):
                exit()
                
mainscreen()
